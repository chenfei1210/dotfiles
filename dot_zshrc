# ZSH plugin
## brew share dir
BREW_SHARE="$(brew --prefix)/share"
## autosuggestions
source "$BREW_SHARE/zsh-autosuggestions/zsh-autosuggestions.zsh"
## history substring search
source "$BREW_SHARE/zsh-history-substring-search/zsh-history-substring-search.zsh"
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
## syntax highlighting
source "$BREW_SHARE/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# starship
eval "$(starship init zsh)"

# mise
eval "$(mise activate zsh)"

chezmoi_git_push() {
    chezmoi git -- add .
    chezmoi git -- commit -m "update dotfiles"
    chezmoi git -- push origin main
}