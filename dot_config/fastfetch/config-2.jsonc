// Based on #1576
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "white"
        },
        "separator": "",
        "bar": {
            "border": {
                "left": "\uee00",
                "leftElapsed": "\uee03",
                "right": "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total": "\uee01",
                "elapsed": "\uee04"
            },
            "color": {
                "total": null
            }
        },
        "percent": {
            "type": [
                "bar",
                "bar-monochrome",
                "num"
            ]
        },
        // Constants are reusable strings referenced by {$1}, {$2}, etc.
        // These contain ANSI escape codes for cursor positioning
        "constants": [
            "──────────────────────────────────────────────", // {$1} - horizontal line for inner borders
            "\u001b[47D", // {$2} - move cursor left 47 columns
            "\u001b[47C", // {$3} - move cursor right 47 columns
            "\u001b[46C", // {$4} - move cursor right 46 columns
            "══════════════════════════════════════════════" // {$5} - horizontal line for outer borders
        ],
        "brightColor": false
    },
    "modules": [
        {
            "type": "version",
            "key": "╔═══════════════╦═{$5}╗\u001b[41D",
            "format": "\u001b[1m{#keys} {1} - {2} "
        },
        {
            "type": "os",
            // Key format breakdown for OS module:
            // "║  {icon} \u001b[s{sysname}\u001b[u\u001b[10C│{$3}║{$2}"
            //
            // ║                    - Left border of key block
            //   {icon}             - OS icon (defined internally by fastfetch)
            //   \u001b[s           - ANSI escape: save cursor position (ESC[s)
            // {sysname}            - Format variable: system name (e.g., "Linux", "Darwin")
            // \u001b[u             - ANSI escape: restore cursor to saved position (ESC[u)
            //                        Necessary because the length of `{sysname}` differs between different platforms
            // \u001b[10C           - ANSI escape: move cursor right 10 columns (ESC[10C)
            // │                    - Right border of key block (always 10 columns from left border)
            // {$3}                 - Reference to constants[2]: move cursor right 47 columns
            // ║                    - Right border of value block
            // {$2}                 - Reference to constants[1]: move cursor left 47 columns
            //
            // This creates a fixed-width layout where the key block is exactly 10 columns wide,
            // regardless of the actual content length. The cursor manipulation ensures proper
            // alignment for the table-like structure.
            "key": "║  {icon} \u001b[s{sysname}\u001b[u\u001b[11C║{$3}║{$2}",
            "format": "{pretty-name}  {#2}[{arch}]"
        },
        {
            "type": "datetime",
            "key": "║  {icon} Datetime   ║{$3}║{$2}",
            "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty} {#2}[{timezone-name}] [{weekday-short}]"
        },
        // Hardware section with green color theme
        {
            "type": "custom",
            "key": "║{#green}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{#bright_green} Hardware "
        },
        {
            "type": "host",
            "key": "║{#green}│ {icon} Machine    │{$4}│{#keys}║{$2}",
            "format": "{name}  {#2}{version}"
        },
        {
            "type": "cpu",
            "key": "║{#green}│ {icon} CPU        │{$4}│{#keys}║{$2}",
            "temp": true,
            "format": "{name} {temperature}  {#2}[C:{core-types}] [@{freq-max}]"
        },
        {
            "type": "gpu",
            "key": "║{#green}│ {icon} GPU        │{$4}│{#keys}║{$2}",
            "temp": true,
            "format": "{name} {temperature}  {#2}[C:{core-count}] [@{frequency}]"
        },
        {
            "type": "memory",
            "key": "║{#green}│ {icon} RAM        │{$4}│{#keys}║{$2}",
            "format": "{percentage-bar}  {#2}[{used} / {total}]"
        },
        {
            "type": "swap",
            "key": "║{#green}│ {icon} SWAP       │{$4}│{#keys}║{$2}",
            "format": "{percentage-bar}  {#2}[{used} / {total}]"
        },
        {
            "type": "disk",
            "key": "║{#green}│ {icon} Disk       │{$4}│{#keys}║{$2}",
            "format": "{size-percentage-bar}  {#2}[{size-used} / {size-total}]",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "║{#green}│ {icon} Battery    │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{#green}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        // Desktop section with yellow color theme
        {
            "type": "custom",
            "key": "║{#yellow}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{#bright_yellow} Desktop "
        },
        {
            "type": "de",
            "key": "║{#yellow}│ {icon} Desktop    │{$4}│{#keys}║{$2}"
        },
        {
            "type": "wm",
            "key": "║{#yellow}│ {icon} Session    │{$4}│{#keys}║{$2}"
        },
        {
            "type": "display",
            "key": "║{#yellow}│ {icon} Display    │{$4}│{#keys}║{$2}",
            "format": "{width}x{height} @{refresh-rate}Hz  {#2}[{name}]"
        },
        {
            "type": "custom",
            "key": "║{#yellow}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        // Terminal section with light_red color theme
        {
            "type": "custom",
            "key": "║{#light_red}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{#bright_light_red} Terminal "
        },
        {
            "type": "shell",
            "key": "║{#light_red}│ {icon} Shell      │{$4}│{#keys}║{$2}",
            "format": "{pretty-name}  {#2}[v{version}] [PID:{pid}]"
        },
        {
            "type": "terminal",
            "key": "║{#light_red}│ {icon} Terminal   │{$4}│{#keys}║{$2}",
            "format": "{pretty-name}  {#2}[{version}] [PID:{pid}]"
        },
        {
            "type": "terminalfont",
            "key": "║{#light_red}│ {icon} Term Font  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "packages",
            "key": "║{#light_red}│ {icon} Packages   │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{#light_red}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        // Development section with red color theme
        {
            "type": "custom",
            "key": "║{#red}┌──────────────┬{$1}┐{#keys}║\u001b[39D",
            "format": "{#bright_red} Development "
        },
        {
            "type": "command",
            "keyIcon": "", // Custom icon override
            "key": "║{#red}│ {icon} Python     │{$4}│{#keys}║{$2}",
            "text": "python3 --version",
            "format": "Python {~7}" // {~7} removes first 7 characters (Python )
        },
        {
            "type": "command",
            "keyIcon": "", // Custom icon override
            "key": "║{#red}│ {icon} Rust       │{$4}│{#keys}║{$2}",
            "text": "rustc --version",
            "format": "rustc {~6,13}" // Print 6th to 13th characters (version number)
        },
        {
            "type": "command",
            "condition": {
                "!system": "Windows" // Posix version
            },
            "keyIcon": "",
            "key": "║{#red}│ {icon} Clang      │{$4}│{#keys}║{$2}",
            "text": "clang --version | sed -n 's/.*version \\([0-9][0-9.]*\\).*/\\1/p'",
            "format": "clang {}"
        },
        {
            "type": "command",
            "condition": {
                "system": "Windows" // Windows version
            },
            "keyIcon": "",
            "key": "║{#red}│ {icon} Clang      │{$4}│{#keys}║{$2}",
            "text": "clang --version | findstr version", // Finds the line with "version"
            "format": "clang {~-6}" // Prints the last 6 characters (version number)
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "║{#red}│ {icon} NodeJS     │{$4}│{#keys}║{$2}",
            "text": "node --version",
            "format": "node {~1}" // {~1} removes first character (v)
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "║{#red}│ {icon} Go         │{$4}│{#keys}║{$2}",
            "text": "go version | cut -d' ' -f3",
            "format": "go {~2}" // {~2} removes first 2 characters (go)
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "║{#red}│ {icon} Zig        │{$4}│{#keys}║{$2}",
            "text": "zig version",
            "format": "zig {}"
        },
        {
            "type": "editor",
            "key": "║{#red}│ {icon} Editor     │{$4}│{#keys}║{$2}"
        },
        {
            "type": "command",
            "keyIcon": "󰊢",
            "key": "║{#red}│ {icon} Git        │{$4}│{#keys}║{$2}",
            "text": "git version",
            "format": "git {~12}"
        },
        {
            "type": "font",
            "key": "║{#red}│ {icon} Interface  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{#red}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        // Uptime section with magenta color theme
        {
            "type": "custom",
            "key": "║{#magenta}┌──────────────┬{$1}┐{#keys}║\u001b[36D",
            "format": "{#bright_magenta} Uptime "
        },
        {
            "type": "title",
            "key": "║{#magenta}│ {icon} Host       │{$4}│{#keys}║{$2}",
            "format": "{host-name}"
        },
        {
            "type": "users",
            "myselfOnly": true, // Only show current user
            "keyIcon": "",
            "key": "║{#magenta}│ {icon} Users      │{$4}│{#keys}║{$2}",
            "format": "{1}@{host-name}{/host-name}localhost{/}{?client-ip}"
        },
        {
            "type": "users",
            "myselfOnly": true, // Only show current user
            "keyIcon": "",
            "key": "║{#magenta}│ {icon} Last Login │{$4}│{#keys}║{$2}",
            "format": "{login-time}"
        },
        {
            "type": "uptime",
            "key": "║{#magenta}│ {icon} Uptime     │{$4}│{#keys}║{$2}"
        },
        {
            "condition": { // Conditional module: only show on non-macOS
                "!system": "macOS"
            },
            "type": "disk",
            "keyIcon": "",
            "key": "║{#magenta}│ {icon} OS Age     │{$4}│{#keys}║{$2}",
            "folders": "/", // Check root filesystem
            "format": "{create-time:10} {#2}[{days} days]" // Show creation time and age in days
        },
        {
            "condition": { // Conditional module: only show on macOS
                "system": "macOS"
            },
            "type": "disk",
            "keyIcon": "",
            "key": "║{#magenta}│ {icon} OS Age     │{$4}│{#keys}║{$2}",
            "folders": "/System/Volumes/VM", // Work around for APFS on macOS
            "format": "{create-time:10} {#2}[{days} days]"
        },
        {
            "type": "custom",
            "key": "║{#magenta}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        // Network section with blue color theme
        {
            "type": "custom",
            "key": "║{#blue}┌──────────────┬{$1}┐{#keys}║\u001b[36D",
            "format": "{#bright_blue} Network "
        },
        {
            // localip IPv4
            "type": "localip",
            "key": "║{#blue}│ {icon} Local IPv4 │{$4}│{#keys}║{$2}",
            "showPrefixLen": false,
            "showIpv4": true,
            "showIpv6": false,
            "showSpeed": true,
            "showMtu": true,
            "format": "{ipv4}  {#2}[{ifname}: MTU:{mtu} / {speed}]"
        },
        {
            // localip IPv6
            "type": "localip",
            "key": "║{#blue}│ {icon} Local IPv6 │{$4}│{#keys}║{$2}",
            "showPrefixLen": false,
            "showIpv4": false,
            "showIpv6": true,
            "showSpeed": true,
            "showMtu": true,
            "format": "{ipv6}  {#2}[{ifname}: MTU:{mtu} / {speed}]"
        },
        {
            // mac
            "type": "localip",
            "key": "║{#blue}│ {icon} MAC        │{$4}│{#keys}║{$2}",
            "showMac": true,
            "format": "{mac}"
        },
        {
            "type": "publicip",
            "key": "║{#blue}│ {icon} Public IPv4│{$4}│{#keys}║{$2}",
            "ipv6": false,
            "format": "{ip}  {#2}[{location}]"
        },
        {
            "type": "publicip",
            "key": "║{#blue}│ {icon} Public IPv6│{$4}│{#keys}║{$2}",
            "ipv6": true,
            "format": "{ip}  {#2}[{location}]"
        },
        {
            "type": "wifi",
            "key": "║{#blue}│ {icon} Wi-Fi      │{$4}│{#keys}║{$2}",
            "format": "{ssid}  {#2}[{inf-desc}: {signal-quality} / {band} GHz]"
        },
        {
            "type": "custom",
            "key": "║{#blue}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },
        {
            "type": "custom",
            "key": "╚═════════════════{$5}╝", // Bottom border of the entire layout
            "format": ""
        }
    ]
}
/*
Key Format Structure Explanation:

The key format uses a combination of:
1. Unicode box drawing characters (│ ┌ ┐ └ ┘ ┬ ┴) for borders
2. ANSI escape codes for cursor positioning (\u001b[...)
3. Format variables ({icon}, {sysname}, etc.)
4. Constant references ({$1}, {$2}, etc.)
5. Color formatting ({#color})

ANSI Escape Codes Used:
- \u001b[s      - Save cursor position (ESC[s)
- \u001b[u      - Restore cursor position (ESC[u)
- \u001b[nC     - Move cursor right n columns (ESC[nC)
- \u001b[nD     - Move cursor left n columns (ESC[nD)

This creates a table-like layout with fixed column widths and proper alignment,
regardless of the actual content length in each field.

For more ANSI escape code reference, see:
https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#cursor-controls
*/